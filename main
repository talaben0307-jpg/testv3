	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(WIDTH, HEIGHT),
	BackgroundColor3 = THEME.bg,
	BorderSizePixel = 0,
	Active = true,
}, gui)
corner(main, 14)
stroke(main, THEME.accent, 1.5, 0.35)
local mainScale = new("UIScale", { Scale = 1 }, main)

