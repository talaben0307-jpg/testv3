		BackgroundTransparency = 0.2,
		Text = text,
		Font = Enum.Font.GothamBold,
		TextSize = 16,
		TextColor3 = THEME.text,
		AutoButtonColor = true,
	}, header)
	corner(b, 8)
	return b
end

local closeBtn = headerButton("X", -10, Color3.fromRGB(200, 60, 80))
local minBtn = headerButton("-", -44, THEME.panel2)

