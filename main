local function addSection(order, title)
	new("TextLabel", {
		LayoutOrder = order,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 18),
		Text = string.upper(title),
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		TextColor3 = THEME.accent2,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, body)
end

local function addToggle(order, title, desc, key, onChange)
	local row = new("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 54),
		BackgroundColor3 = THEME.panel,
		BorderSizePixel = 0,
	}, body)
	corner(row, 10)

	new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.new(1, -80, 0, 18),
		Text = title,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextColor3 = THEME.text,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 28),
		Size = UDim2.new(1, -80, 0, 16),
		Text = desc,
		Font = Enum.Font.Gotham,
		TextSize = 11,
		TextColor3 = THEME.sub,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)

	local track_ = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(44, 24),
		BackgroundColor3 = THEME.off,
		BorderSizePixel = 0,
	}, row)
	corner(track_, 12)
	local knob = new("Frame", {
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.fromOffset(18, 18),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, track_)
	corner(knob, 9)

	local function render(animate)
		local on = Config[key]
		local trackColor = on and THEME.accent or THEME.off
		local knobPos = on and UDim2.fromOffset(23, 3) or UDim2.fromOffset(3, 3)
		if animate then
			tween(track_, 0.18, { BackgroundColor3 = trackColor })
			tween(knob, 0.18, { Position = knobPos })
		else
			track_.BackgroundColor3 = trackColor
			knob.Position = knobPos
		end
	end
	render(false)

	local btn = new("TextButton", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Text = "",
	}, row)
	btn.Activated:Connect(function()
		Config[key] = not Config[key]
		render(true)
		if onChange then
			onChange(Config[key])
		end
	end)
end

local function roundTo(x, decimals)
	local m = 10 ^ decimals
	return math.floor(x * m + 0.5) / m
end

local function addStepper(order, title, key, minV, maxV, step, decimals)
	local row = new("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = THEME.panel,
		BorderSizePixel = 0,
	}, body)
	corner(row, 10)

	new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -130, 1, 0),
		Text = title,
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextColor3 = THEME.text,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)

	local function stepBtn(text, xOffset)
		local b = new("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, xOffset, 0.5, 0),
			Size = UDim2.fromOffset(28, 28),
			BackgroundColor3 = THEME.panel2,
			Text = text,
			Font = Enum.Font.GothamBold,
			TextSize = 16,
			TextColor3 = THEME.text,
		}, row)
		corner(b, 8)
		return b
	end

	local plus = stepBtn("+", -10)
	local valueLabel = new("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -42, 0.5, 0),
		Size = UDim2.fromOffset(48, 28),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = THEME.accent2,
	}, row)
	local minus = stepBtn("-", -94)

	local function render()
		valueLabel.Text = tostring(roundTo(Config[key], decimals))
	end
	render()

	local function change(delta)
		Config[key] = math.clamp(roundTo(Config[key] + delta, decimals), minV, maxV)
		render()
	end
	plus.Activated:Connect(function() change(step) end)
	minus.Activated:Connect(function() change(-step) end)
end

addSection(1, "Chức năng")
addToggle(2, "Tự đỡ đòn", "Giữ phím F khi có đòn tới gần", "AutoBlock", function(on)
	if not on then
		releaseBlock()
	end
end)
addToggle(3, "Tự né chiêu", "Dịch chuyển khi có chiêu nguy hiểm", "AutoDodge")

addSection(4, "Tùy chỉnh đỡ đòn")
addStepper(5, "Khoảng cách tối thiểu", "BlockMin", 0, 10, 0.5, 1)
addStepper(6, "Khoảng cách tối đa", "BlockMax", 5, 40, 0.5, 1)
addStepper(7, "Thời gian nhả (giây)", "ReleaseDelay", 0.05, 1, 0.05, 2)

addSection(8, "Tùy chỉnh né chiêu")
addStepper(9, "Phạm vi nguy hiểm", "DangerRange", 20, 200, 5, 0)
addStepper(10, "Khoảng cách né", "EscapeDistance", 15, 120, 5, 0)
addStepper(11, "Hồi chiêu né (giây)", "DodgeCooldown", 0.5, 10, 0.5, 1)

