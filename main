local env = (getgenv and getgenv()) or _G
if env.__AutoDefenseUnload then
	pcall(env.__AutoDefenseUnload)
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer

local Config = {
	AutoBlock = true,
	AutoBlockDash = false,
	AutoDodge = true,
	DangerRange = 75,
	BlockMin = 2.5,
	BlockMax = 14.5,
	ReleaseDelay = 0.2,
	DodgeCooldown = 2,
	EscapeDistance = 45,
	DashRange = 25,
	DashSpeed = 40,
}

local CHECK_INTERVAL = 0.1
local BLOCK_KEY = Enum.KeyCode.F
local MENU_KEY = Enum.KeyCode.RightShift
local MAX_HOLD = 1
local HOLD_LOCKOUT = 0.35
local KEY_LOCKOUT = 0.6

local BLOCK_EFFECTS = {
	"CombatTrail", "LapseBlue", "HandTrail", "Shock", "BallFire", "Reserve",
	"Doors", "TwoFold", "Rabbit", "Spawn", "DivineAttack", "Throw",
	"FocusStrike", "DrillImpact", "Barrage", "Mucus", "MucusFire",
	"DismantleFly", "HitGlow",
	"ReversalRed", "BlackFlash", "RepellingBlackFlash", "CursedStrike",
	"CrushingBow", "ManjiKick", "Cleave", "Dismantle", "FireArrow",
	"HammerStrike", "Chainwhip", "NueFlight", "RabbitHole", "Garuda",
	"GarudaStab", "ShutterDoors", "RoughEnergy", "FeverBreaker",
	"PachinkoCombo", "LurkingShadow", "PassengerOfDeath", "TwofoldKick",
}

local DANGER_EFFECTS = {
	"DomainBurst", "Domain", "RushWind", "HotHands", "WorldSlash",
	"RitualStart", "EyeTrails", "DivergentFist", "LapseBlueMax", "Purple",
	"ReversalRedMax",
	"InfiniteVoid", "MalevolentShrine", "HollowPurple", "IdleDeathGamble",
	"EmbodimentOfSelfPerfection", "WorldCuttingSlash",
}

local OWNER_ATTRIBUTES = { "Owner", "Creator", "Caster", "User", "Player" }

local function toSet(list)
	local set = {}
	for _, name in ipairs(list) do
		set[name] = true
	end
	return set
end

local blockNames = toSet(BLOCK_EFFECTS)
local dangerNames = toSet(DANGER_EFFECTS)

local connections = {}
local function track(conn)
	table.insert(connections, conn)
	return conn
end

local blockParts = {}
local dangerParts = {}
local dodgedParts = {}

local lastPositions = setmetatable({}, { __mode = "k" })
local lastSampleTime = setmetatable({}, { __mode = "k" })

local character = nil
local rootPart = nil
local blockHeld = false
local lastBlockTrigger = 0
local blockStart = 0
local lockUntil = 0
local lastDodge = 0
local accumulator = 0
local alive = true

local ui = {}

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude

local STATUS_WATCH = "Đang canh / Watching"
local STATUS_BLOCK = "Đang đỡ / Blocking"
local STATUS_DODGE = "Đã né / Dodged"

local function setBlock(down)
	pcall(function()
		VirtualInputManager:SendKeyEvent(down, BLOCK_KEY, false, game)
	end)
	blockHeld = down
	if down then
		blockStart = os.clock()
	end
	if ui.setStatus then
		if down then
			ui.setStatus(STATUS_BLOCK, Color3.fromRGB(80, 220, 140))
		else
			ui.setStatus(STATUS_WATCH, Color3.fromRGB(90, 170, 255))
		end
	end
end

local function releaseBlock()
	if blockHeld then
		setBlock(false)
	end
end

local function isOwnPart(part)
	return character ~= nil and part:IsDescendantOf(character)
end

local function ownerMatches(value)
	if value == nil then
		return false
	end
	return value == player.Name or value == player.UserId or value == player.DisplayName
end

local function ancestorIsOwn(part)
	if isOwnPart(part) then
		return true
	end
	local node = part
	while node and node ~= Workspace do
		if node.Name == player.Name or node.Name == tostring(player.UserId) then
			return true
		end
		for _, attr in ipairs(OWNER_ATTRIBUTES) do
			if ownerMatches(node:GetAttribute(attr)) then
				return true
			end
		end
		local ownerValue = node:FindFirstChild("Owner") or node:FindFirstChild("Creator")
		if ownerValue and ownerValue:IsA("ObjectValue") and ownerValue.Value then
			local v = ownerValue.Value
			if v == player or v == character then
				return true
			end
		end
		node = node.Parent
	end
	return false
end

local function nearestCharacterIsOwn(part)
	local bestDist = math.huge
	local bestIsOwn = false
	for _, plr in ipairs(Players:GetPlayers()) do
		local char = plr.Character
		local r = char and char:FindFirstChild("HumanoidRootPart")
		if r then
			local d = (r.Position - part.Position).Magnitude
			if d < bestDist then
				bestDist = d
				bestIsOwn = (plr == player)
			end
		end
	end
	return bestIsOwn
end

local function classify(obj)
	if not obj.Parent then
		return
	end
	if ancestorIsOwn(obj) or nearestCharacterIsOwn(obj) then
		return
	end
	local name = obj.Name
	if blockNames[name] then
		blockParts[obj] = true
	end
	if dangerNames[name] then
		dangerParts[obj] = true
	end
end

local function register(obj)
	if not obj:IsA("BasePart") then
		return
	end
	local name = obj.Name
	if blockNames[name] or dangerNames[name] then
		task.defer(classify, obj)
	end
end

local function unregister(obj)
	if obj:IsA("BasePart") then
		blockParts[obj] = nil
		dangerParts[obj] = nil
		dodgedParts[obj] = nil
	end
end

track(Workspace.DescendantAdded:Connect(register))
track(Workspace.DescendantRemoving:Connect(unregister))

task.spawn(function()
	local count = 0
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if not alive then
			return
		end
		register(obj)
		count += 1
		if count % 300 == 0 then
			task.wait()
		end
	end
end)

local function onCharacter(char)
	character = char
	rootPart = nil
	releaseBlock()

	local root = char:WaitForChild("HumanoidRootPart", 10)
		or char:FindFirstChild("UpperTorso")
		or char:FindFirstChild("Torso")
	if character ~= char then
		return
	end

	rootPart = root
	raycastParams.FilterDescendantsInstances = { char }

	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Died:Connect(releaseBlock)
	end
end

track(player.CharacterAdded:Connect(onCharacter))
if player.Character then
	task.spawn(onCharacter, player.Character)
end

local function tryDodge(root, now)
	if now - lastDodge < Config.DodgeCooldown then
		return
	end

	for part in pairs(dangerParts) do
		if part.Parent and not dodgedParts[part] then
			local offset = root.Position - part.Position
			local dist = offset.Magnitude

			if dist > 0.01 and dist <= Config.DangerRange then
				dodgedParts[part] = true
				lastDodge = now

				local target = root.Position + offset.Unit * Config.EscapeDistance
				local result = Workspace:Raycast(
					target + Vector3.new(0, 50, 0),
					Vector3.new(0, -150, 0),
					raycastParams
				)
				local y = result and (result.Position.Y + 2) or root.Position.Y

				root.CFrame = CFrame.new(target.X, y, target.Z) * root.CFrame.Rotation
				if ui.setStatus then
					ui.setStatus(STATUS_DODGE, Color3.fromRGB(255, 190, 80))
				end
				break
			end
		end
	end
end

local function dashThreat(root, now)
	local threat = false
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local char = plr.Character
			local r = char and char:FindFirstChild("HumanoidRootPart")
			if r then
				local pos = r.Position
				local prevPos = lastPositions[r]
				local prevTime = lastSampleTime[r]
				lastPositions[r] = pos
				lastSampleTime[r] = now

				local vel = r.AssemblyLinearVelocity
				if prevPos and prevTime then
					local span = now - prevTime
					if span >= 0.05 and span <= 0.3 then
						local measured = (pos - prevPos) / span
						if measured.Magnitude > vel.Magnitude and measured.Magnitude < 250 then
							vel = measured
						end
					end
				end

				local offset = root.Position - pos
				local dist = offset.Magnitude
				if dist <= Config.DashRange and dist > Config.BlockMin then
					local flat = Vector3.new(vel.X, 0, vel.Z)
					local flatOffset = Vector3.new(offset.X, 0, offset.Z)
					if flat.Magnitude >= Config.DashSpeed and flatOffset.Magnitude > 0.01 then
						local closing = flat:Dot(flatOffset.Unit)
						if closing >= Config.DashSpeed * 0.8 and flat.Unit:Dot(flatOffset.Unit) > 0.85 then
							threat = true
						end
					end
				end
			end
		end
	end
	return threat
end

local function updateBlock(root, now)
	local shouldBlock = false

	if Config.AutoBlock then
		for part in pairs(blockParts) do
			if part.Parent then
				local dist = (root.Position - part.Position).Magnitude
				if dist >= Config.BlockMin and dist <= Config.BlockMax then
					shouldBlock = true
					break
				end
			end
		end
	end

	if Config.AutoBlockDash and dashThreat(root, now) then
		shouldBlock = true
	end

	if blockHeld and (now - blockStart) >= MAX_HOLD then
		setBlock(false)
		lockUntil = now + HOLD_LOCKOUT
		return
	end

	if now < lockUntil then
		return
	end

	if shouldBlock then
		lastBlockTrigger = now
		if not blockHeld then
			setBlock(true)
		end
	elseif blockHeld and (now - lastBlockTrigger) >= Config.ReleaseDelay then
		setBlock(false)
	end
end

track(RunService.Heartbeat:Connect(function(dt)
	local root = rootPart
	if not root or not root.Parent then
		return
	end

	accumulator += dt
	if accumulator < CHECK_INTERVAL then
		return
	end
	accumulator -= CHECK_INTERVAL

	local now = os.clock()
	if Config.AutoDodge then
		tryDodge(root, now)
	end
	if Config.AutoBlock or Config.AutoBlockDash then
		updateBlock(root, now)
	else
		releaseBlock()
	end
end))

local THEME = {
	bg = Color3.fromRGB(16, 16, 22),
	panel = Color3.fromRGB(26, 26, 36),
	panel2 = Color3.fromRGB(34, 34, 48),
	accent = Color3.fromRGB(130, 90, 255),
	accent2 = Color3.fromRGB(70, 170, 255),
	text = Color3.fromRGB(236, 236, 245),
	sub = Color3.fromRGB(140, 140, 165),
	off = Color3.fromRGB(58, 58, 76),
}

local function new(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		inst[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function corner(inst, r)
	return new("UICorner", { CornerRadius = UDim.new(0, r) }, inst)
end

local function stroke(inst, color, thickness, transparency)
	return new("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, inst)
end

local function tween(inst, t, props)
	TweenService:Create(inst, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local gui = new("ScreenGui", {
	Name = "AutoDefenseUI",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	DisplayOrder = 999,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
})

local function attachGui()
	local candidates = {
		function() return gethui and gethui() end,
		function() return game:GetService("CoreGui") end,
		function() return player:WaitForChild("PlayerGui", 10) end,
	}
	for _, getParent in ipairs(candidates) do
		local ok, parent = pcall(getParent)
		if ok and parent then
			if syn and syn.protect_gui then
				pcall(syn.protect_gui, gui)
			end
			local okSet = pcall(function()
				gui.Parent = parent
			end)
			if okSet and gui.Parent then
				return true
			end
		end
	end
	return false
end

if not attachGui() then
	warn("[AutoDefense] GUI attach failed")
end

