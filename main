new("UIGradient", {
	Color = ColorSequence.new(THEME.accent, THEME.accent2),
	Rotation = 45,
}, bubble)

local function setOpen(open)
	if open then
		main.Visible = true
		bubble.Visible = false
		mainScale.Scale = 0.9
		tween(mainScale, 0.18, { Scale = 1 })
	else
		main.Visible = false
		bubble.Visible = true
	end
end

minBtn.Activated:Connect(function() setOpen(false) end)
bubble.Activated:Connect(function() setOpen(true) end)

local function unload()
	alive = false
	releaseBlock()
	for _, c in ipairs(connections) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(connections)
	gui:Destroy()
	env.__AutoDefenseUnload = nil
end
env.__AutoDefenseUnload = unload
closeBtn.Activated:Connect(unload)

track(UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == MENU_KEY then
		setOpen(not main.Visible)
	end
end))

local dragging, dragStart, startPos = false, nil, nil
header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = main.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)
track(UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		local d = input.Position - dragStart
		main.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + d.X,
			startPos.Y.Scale, startPos.Y.Offset + d.Y
		)
	end
end))

setOpen(true)
ui.setStatus("Đang canh", THEME.accent2)
