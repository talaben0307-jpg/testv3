	BackgroundTransparency = 1,
	Position = UDim2.fromOffset(28, 0),
	Size = UDim2.new(1, -40, 1, 0),
	Text = STATUS_WATCH,
	Font = Enum.Font.GothamMedium,
	TextSize = 12,
	TextColor3 = THEME.text,
	TextXAlignment = Enum.TextXAlignment.Left,
}, footer)

function ui.setStatus(text, color)
	if statusLabel.Text == text then
		return
	end
	statusLabel.Text = text
	tween(statusDot, 0.15, { BackgroundColor3 = color })
end

local bubble = new("TextButton", {
	Name = "Bubble",
	Position = UDim2.new(0, 16, 0.5, -24),
	Size = UDim2.fromOffset(48, 48),
	BackgroundColor3 = THEME.accent,
	Text = "AD",
	Font = Enum.Font.GothamBlack,
	TextSize = 16,
	TextColor3 = Color3.new(1, 1, 1),
	Visible = false,
	AutoButtonColor = true,
}, gui)
corner(bubble, 24)
stroke(bubble, Color3.new(1, 1, 1), 1.5, 0.6)
new("UIGradient", {
	Color = ColorSequence.new(THEME.accent, THEME.accent2),
	Rotation = 45,
}, bubble)

local function setOpen(open)
	if open then
		main.Visible = true
		bubble.Visible = false
		mainScale.Scale = 0.9
		tween(mainScale, 0.18, { Scale = 1 })
	else
		main.Visible = false
		bubble.Visible = true
	end
end

minBtn.Activated:Connect(function() setOpen(false) end)
bubble.Activated:Connect(function() setOpen(true) end)

local function unload()
	alive = false
	releaseBlock()
	for _, c in ipairs(connections) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(connections)
	gui:Destroy()
	env.__AutoDefenseUnload = nil
end
env.__AutoDefenseUnload = unload
closeBtn.Activated:Connect(unload)

track(UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.UserInputType == Enum.UserInputType.Keyboard
		and input.KeyCode ~= BLOCK_KEY
		and input.KeyCode ~= MENU_KEY then
		releaseBlock()
		lockUntil = os.clock() + KEY_LOCKOUT
		return
	end
	if input.KeyCode == MENU_KEY then
		setOpen(not main.Visible)
	end
end))

local dragging, dragStart, startPos = false, nil, nil
header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = main.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)
track(UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		local d = input.Position - dragStart
		main.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + d.X,
			startPos.Y.Scale, startPos.Y.Offset + d.Y
		)
	end
end))

setOpen(true)
ui.setStatus(STATUS_WATCH, THEME.accent2)
